# ─────────────────────────────────────────────────────────────
#  apps/web — plantilla. NUNCA poner valores reales aquí (ese
#  archivo SÍ está versionado). Los valores reales van en .env
#  (ignorado por git). Ver también el .env.example de la raíz.
#
#  Solo variables NUXT_PUBLIC_* y la anon key llegan al navegador
#  (SEC-02, Fase I §17) — nunca la service_role key.
# ─────────────────────────────────────────────────────────────

NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME="Aquila PH"

# @nuxtjs/supabase (D-16) lee estos nombres por defecto — mismos valores
# que los NUXT_PUBLIC_SUPABASE_* de arriba.
SUPABASE_URL=
SUPABASE_KEY=
