{
  "name": "@aquila/liquidation-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "default": "./dist/graph.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./prueba-formula": {
      "types": "./dist/prueba-formula.d.ts",
      "default": "./dist/prueba-formula.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aquila/ael-core": "workspace:*",
    "@aquila/ael-language": "workspace:*",
    "@aquila/ael-runtime": "workspace:*",
    "@aquila/financial-kernel": "workspace:*",
    "@aquila/shared": "workspace:*"
  }
}
