# ─────────────────────────────────────────────────────────────
#  AQUILA — PLANTILLA de variables de PRODUCCIÓN (D-25)
#
#  ⚠  ESTE ARCHIVO ESTÁ VERSIONADO EN GIT.
#     Nunca escribas valores reales aquí. Deja las claves vacías.
#     Los valores reales van en .env.production, que está ignorado por git.
#
#  Uso: copiar a .env.production y rellenar allí con las credenciales del
#  proyecto Supabase de PRODUCCIÓN (distinto del de desarrollo, ver .env.example).
#  Solo lo usan los comandos manuales de promoción — `pnpm db:push:prod` —,
#  no la app ni Nuxt. CI nunca lee este archivo (D-25: CI corre solo contra
#  desarrollo).
# ─────────────────────────────────────────────────────────────

# ── Supabase (proyecto remoto de PRODUCCIÓN — ver DECISIONES.md D-25) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SECRETO — salta toda RLS. Solo servidor / Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# SECRETO — cadena de conexión Postgres. Solo para `pnpm db:push:prod`.
# Project Settings → Database → Connection string → Session pooler
SUPABASE_DB_URL=

# SECRETO — token personal de tu cuenta Supabase (es de la CUENTA, no del
# proyecto — el mismo valor que ya usás en .env para `pnpm db:types`).
SUPABASE_ACCESS_TOKEN=
