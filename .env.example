# ─────────────────────────────────────────────────────────────
#  AQUILA — PLANTILLA de variables de entorno
#
#  ⚠  ESTE ARCHIVO ESTÁ VERSIONADO EN GIT.
#     Nunca escribas valores reales aquí. Deja las claves vacías.
#     Los valores reales van en .env, que está ignorado por git.
#
#  Uso:  copiar a .env  y rellenar allí.
#
#  Regla SEC-02: solo NUXT_PUBLIC_* y SUPABASE_ANON_KEY pueden
#  llegar al navegador. Cualquier otra en runtimeConfig.public
#  es un fallo de seguridad.
# ─────────────────────────────────────────────────────────────

# ── Supabase (proyecto remoto de desarrollo — ver DECISIONES.md D-08) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SECRETO — salta toda RLS. Solo servidor / Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# SECRETO — cadena de conexión Postgres. Solo para aplicar migraciones.
# Project Settings → Database → Connection string → Session pooler
SUPABASE_DB_URL=

# SECRETO — token personal de tu cuenta Supabase, no del proyecto.
# Solo para `pnpm db:types` (D-11). Generar en:
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── App ──
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME="Aquila PH"

# ── Email transaccional (Brevo — AD-07) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ── SMS transaccional (Brevo Transactional SMS) ──
# Remitente alfanumérico, máximo 11 caracteres (lo valida sms_provider.ts
# al arrancar la función). Reutiliza BREVO_API_KEY de arriba.
BREVO_SMS_SENDER=

# ── Rate limiting (Upstash) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
