# ─────────────────────────────────────────────────────────────
#  AQUILA — variables de entorno
#  Copiar a .env y rellenar. NUNCA versionar .env.
#  Regla: solo NUXT_PUBLIC_* y SUPABASE_ANON_KEY pueden llegar
#  al navegador. Cualquier otra en runtimeConfig.public es un
#  fallo de seguridad (Fase I, SEC-02).
# ─────────────────────────────────────────────────────────────

# ── Supabase (proyecto remoto de desarrollo — ver DECISIONES.md D-08) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
NUXT_PUBLIC_APP_URL=http://localhost:3000
NUXT_PUBLIC_APP_NAME="Aquila PH"

# ── Email transaccional (Brevo — AD-07) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# ── Rate limiting (Upstash) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
